# Copier ce fichier en .env (non versionné) et adapter les valeurs si besoin.
# Ces variables sont lues par docker-compose.yml (conteneurs PostgreSQL/MongoDB)
# ainsi que par les services Spring Boot (via les fichiers de config centralisés
# de config-server, qui utilisent ${VAR:defaut}) au démarrage local.
#
# Valeurs par défaut (si non définies) : "franck" pour rester cohérent avec le
# renommage du package com.alibou -> com.franck. À changer en production.

# PostgreSQL (services order, payment, product)
POSTGRES_USER=franck
POSTGRES_PASSWORD=franck
# Port hôte exposé par le conteneur ms_pg_sql (5432 est déjà pris par un
# PostgreSQL natif sur certaines machines de dev, d'où le défaut à 5433 ;
# adapter aussi les URL jdbc:postgresql://localhost:<port>/... dans
# services/config-server/src/main/resources/configurations/*.yml si changé).
POSTGRES_PORT=5433

# MongoDB (services customer, notification) + Mongo Express
MONGO_INITDB_ROOT_USERNAME=franck
MONGO_INITDB_ROOT_PASSWORD=franck

# SMTP / MailDev (service notification)
SMTP_USERNAME=franck
SMTP_PASSWORD=franck

# pgAdmin (optionnel, déjà avec défauts dans docker-compose.yml)
PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
PGADMIN_DEFAULT_PASSWORD=admin
